{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Guided Plan IR",
  "description": "Typed intermediate representation for a guided-plan. The planner agent/skill emits this JSON; the harness gate `guided_run.py validate-plan` must PASS before guided-builder starts. Archify-style: typed IR + deterministic gate instead of prose-only plans.",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "blast_radius", "steps", "test_strategy", "done_criteria", "source_of_standards"],
  "properties": {
    "goal": { "type": "string", "minLength": 10 },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "blast_radius": {
      "type": "object",
      "required": ["files"],
      "properties": {
        "files": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "justification": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "action"],
        "properties": {
          "file": { "type": "string" },
          "action": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "key_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision", "why"],
        "properties": {
          "decision": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "test_strategy": {
      "type": "object",
      "required": ["tests"],
      "properties": {
        "tests": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "coverage_min": { "type": "number", "minimum": 0, "maximum": 100, "default": 80 }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "enforcement"],
        "properties": {
          "rule": { "type": "string" },
          "enforcement": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "outbox"],
        "properties": {
          "name": { "type": "string" },
          "outbox": { "type": "boolean" }
        }
      }
    },
    "done_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "accuracy": {
      "type": "object",
      "properties": {
        "mutation_min_backend": { "type": "number", "minimum": 0, "maximum": 100 },
        "mutation_min_frontend": { "type": "number", "minimum": 0, "maximum": 100 },
        "mutation_scope": { "type": "array", "items": { "type": "string" } },
        "contract_tests": { "type": "array", "items": { "type": "string" } },
        "arch_rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source_of_standards": { "type": "string", "minLength": 3 }
  }
}
